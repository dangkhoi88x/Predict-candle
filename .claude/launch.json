{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "./mvnw",
      "runtimeArgs": [
        "spring-boot:run"
      ],
      "port": 8080
    },
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8081",
        "--directory",
        "src/main/resources/static"
      ],
      "port": 8081
    }
  ]
}
